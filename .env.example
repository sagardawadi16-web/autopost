# ==============================================================================
# AutoPost Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#      cp .env.example .env      (Linux/macOS)
#      copy .env.example .env    (Windows PowerShell / CMD)
# 2. Fill in your actual API keys and tokens below.
# 3. NEVER commit your '.env' file or credentials to Git/GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini AI (Required)
# ------------------------------------------------------------------------------
# Powers autonomous story generation, content evaluation, viral hooks, and SEO.
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# YouTube Data API v3 OAuth Credentials (Required for uploads)
# ------------------------------------------------------------------------------
# 1. Go to Google Cloud Console: https://console.cloud.google.com/
# 2. Create a project and enable 'YouTube Data API v3'.
# 3. Configure OAuth Consent Screen (External / In-production or Testing).
# 4. Create Credentials -> OAuth client ID -> Application type: Desktop app.
# 5. Copy the Client ID and Client Secret below.
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here

# ------------------------------------------------------------------------------
# YouTube Channel Refresh Tokens (Generated via CLI)
# ------------------------------------------------------------------------------
# Run the interactive authorizer to authenticate each channel:
#   python -m src.pipeline --authorize --channel english
#   python -m src.pipeline --authorize --channel hindi
# The command will open your browser and print the refresh token to paste here.
YT_EN_REFRESH_TOKEN=your_english_channel_refresh_token_here
YT_HI_REFRESH_TOKEN=your_hindi_channel_refresh_token_here

# Default video visibility on YouTube ('public', 'unlisted', or 'private', default: public)
YOUTUBE_PRIVACY_STATUS=public

# ------------------------------------------------------------------------------
# Reddit API Credentials (Optional)
# ------------------------------------------------------------------------------
# If omitted or unavailable, the pipeline autonomously falls back to Gemini AI
# to generate authentic, high-engagement viral stories with zero downtime.
# To use Reddit directly, create a 'script' app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=autopost:v1.0.0 (by /u/your_reddit_username)

# ------------------------------------------------------------------------------
# Cloudflare R2 / S3 Storage (Optional)
# ------------------------------------------------------------------------------
# Used for offsite video and asset archiving.
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
